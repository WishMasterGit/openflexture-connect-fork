{
  "name": "openflexure-connect",
  "version": "5.0.0",
  "private": true,
  "main": "./out/main/index.js",
  "description": "An electron-based user client for the OpenFlexure Microscope",
  "author": "OpenFlexure <contact@openflexure.org> (https://www.openflexure.org)",
  "homepage": "https://www.openflexure.org",
  "license": "GPL-3.0",
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "start": "electron-vite preview",
    "dev": "electron-vite --inspect --sourcemap dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.0.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "axios": "^1.9.0",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "eslint": "^9.24.0",
    "eslint-plugin-vue": "^10.0.0",
    "ipaddr.js": "^2.2.0",
    "less": "^4.3.0",
    "prettier": "^3.5.3",
    "uikit": "^3.23.9",
    "vite": "^6.2.6",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^10.1.3"
  }
}
