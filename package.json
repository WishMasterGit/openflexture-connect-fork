{
  "name": "openflexure-connect",
  "version": "2.2.0-alpha",
  "private": true,
  "description": "An electron-based user client for the OpenFlexure Microscope Server",
  "author": "OpenFlexure <contact@openflexure.org> (https://www.openflexure.org)",
  "scripts": {
    "electron:build": "vue-cli-service electron:build",
    "electron:serve": "vue-cli-service electron:serve",
    "electron:release": "vue-cli-service electron:build -wl",
    "electron:generate-icons": "electron-icon-builder --input=./public/icon.png --output=build",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "about-window": "^1.13.2",
    "electron-context-menu": "^2.0.1",
    "electron-progressbar": "^1.2.0",
    "electron-store": "^5.1.1",
    "electron-updater": "^4.3.1",
    "material-design-icons": "^3.0.1"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "^4.4.1",
    "@vue/cli-service": "^4.4.1",
    "axios": "^0.19.2",
    "babel-eslint": "^10.1.0",
    "css-loader": "^3.5.3",
    "electron": "^9.0.0",
    "electron-builder": "^22.7.0",
    "electron-icon-builder": "^1.0.2",
    "eslint": "^7.1.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-prettier": "^3.1.3",
    "eslint-plugin-vue": "^6.2.2",
    "less": "^3.11.1",
    "less-loader": "^6.1.0",
    "mdns-js": "^1.0.3",
    "uikit": "^3.5.0",
    "vue": "^2.6.11",
    "vue-cli-plugin-electron-builder": "^1.4.6",
    "vue-template-compiler": "^2.6.11"
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "displayName": "OpenFlexure eV",
  "homepage": "https://gitlab.com/openflexure/openflexure-microscope-jsclient",
  "license": "GNU General Public License v3.0 ",
  "main": "background.js",
  "optionalDependencies": {
    "electron-windows-store": "^2.1.0"
  },
  "productName": "OpenFlexure eV",
  "publisher": "Bath Open Instrumentation Group"
}
