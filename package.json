{
  "name": "openflexure-connect",
  "publisher": "OpenFlexure",
  "productName": "OpenFlexure Connect",
  "version": "3.0.0",
  "private": true,
  "description": "An electron-based user client for the OpenFlexure Microscope",
  "author": "OpenFlexure <contact@openflexure.org> (https://www.openflexure.org)",
  "scripts": {
    "electron:build": "vue-cli-service electron:build",
    "electron:serve": "vue-cli-service electron:serve",
    "electron:release": "vue-cli-service electron:build -wl",
    "electron:generate-icons": "electron-icon-builder --input=./public/icon.png --output=build --flatten",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps",
    "lint": "vue-cli-service lint",
    "makemanifests": "node ./genWingetManifest.js"
  },
  "dependencies": {
    "about-window": "^1.13.4",
    "electron-context-menu": "^2.0.1",
    "electron-progressbar": "^1.2.0",
    "electron-store": "^5.2.0",
    "electron-updater": "^4.3.1",
    "material-design-icons": "^3.0.1"
  },
  "devDependencies": {
    "@vue/cli-plugin-eslint": "^4.4.6",
    "@vue/cli-service": "^4.4.6",
    "axios": "^0.19.2",
    "css-loader": "^3.6.0",
    "electron": "^9.0.5",
    "electron-builder": "^22.7.0",
    "electron-icon-builder": "^1.0.2",
    "eslint": "^7.3.1",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-prettier": "^3.1.4",
    "eslint-plugin-vue": "^6.2.2",
    "less": "^3.11.3",
    "less-loader": "^6.1.2",
    "mdns-js": "^1.0.3",
    "sha256-file": "^1.0.0",
    "uikit": "^3.5.4",
    "vue": "^2.6.11",
    "vue-cli-plugin-electron-builder": "^1.4.6",
    "vue-template-compiler": "^2.6.11",
    "yaml": "^1.10.0"
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "homepage": "https://gitlab.com/openflexure/openflexure-connect",
  "license": "GNU General Public License v3.0 ",
  "main": "background.js"
}
